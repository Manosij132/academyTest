	<ItemGroup Condition="'$(Configuration)' == 'Development'">
		<Content Update="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>appsettings.json</Link>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'QA'">
		<Content Update="appsettings.QA.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>appsettings.json</Link>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Production'">
		<Content Update="appsettings.Production.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<Link>appsettings.json</Link>
		</Content>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' != 'Development' and '$(Configuration)' != 'QA' and '$(Configuration)' != 'Production'">
		<Content Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

