		<ProjectReference Include="..\..\Workers\ReportWorker\ReportWorker.csproj" />
		<ProjectReference Include="..\..\Workers\SyncEmployeeWorker\SyncEmployeeWorker.csproj" />
		<ProjectReference Include="..\..\Workers\SendEmailWorker\SendEmailWorker.csproj" />
