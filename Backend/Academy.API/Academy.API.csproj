<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>disable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>d42303cd-bb67-466b-9cc9-c817c24bb237</UserSecretsId>
		<Configurations>Debug;Release;Development;QA;Production</Configurations>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="EmailTemplates\DAILY_REMINDER.HTM" />
		<None Remove="EmailTemplates\template2.html" />

	</ItemGroup>

	<ItemGroup>
		<Content Include="EmailTemplates\DAILY_REMINDER.HTM">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="EmailTemplates\template2.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

	</ItemGroup>
